{
  "venvPath": "client/",
  "venv": ".venv",
  "include": ["client/"],
  "exclude": [
    "client/.venv",
    "client/src/foreverbull/pb",
    "client/.idea",
    "client/templates",
    "client/tests/end_to_end",
    "client/tests/integration"
  ],
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": [
        "client/src",
        "client/cli/src",
        "client/testing/src",
        "client/zipline/src"
      ]
    }
  ]
}

