        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["count"], "fields": "/^Backtest$/", "values": false },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "lhjnilsson-foreverbull-datasource", "uid": "foreverbull" },
          "refId": "A",
          "queryType": "ListExecutionOverview",
          "backtest": "$backtest"
