{
  "uid": "fb-backtest-overview",
  "title": "Backtest overview",
  "description": "Leaderboard of executions whose start_date..end_date overlaps the time picker. Saved time is the last two years, so older runs stay hidden until the range is widened. Figures are the last stored period and are not rescaled. Return and drawdown are fractions (percentunit). Sharpe and Sortino are ratios (none). Ending portfolio value is currencyUSD. A row opens /d/ee9ep4jxtwkcgf?var-execution={uuid} and adds var-backtest when the name is known. That execution page still works with only var-execution.",
  "tags": ["foreverbull", "backtest"],
  "schemaVersion": 40,
  "refresh": "",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "timezone": "utc",
  "weekStart": "",
  "time": {
    "from": "now-2y",
    "to": "now"
  },
  "timepicker": {
    "hidden": false,
    "refresh_intervals": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": false,
      "title": "Backtest execution",
      "tooltip": "Inspect one run. Each row on this board opens that run.",
      "type": "link",
      "url": "/d/ee9ep4jxtwkcgf"
    }
  ],
